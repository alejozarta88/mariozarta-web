---
import Base from '../layouts/Base.astro';
import Lanes from '../components/Lanes.astro';
import AgentCard from '../components/AgentCard.astro';
import Method from '../components/Method.astro';
import Contact from '../components/Contact.astro';
import { agentes } from '../data/agentes';
---
<Base title="Mario Zarta · Agentes de IA" description="Arquitecto de soluciones de IA. Agentes que llegan a producción: el modelo conversa, el código decide.">
  <div class="top">
    <a class="brand" href="/">Mario Zarta <span>· agentes de IA</span></a>
    <nav aria-label="Secciones"><a href="#agentes">Agentes</a><a href="/arquitectura">Arquitectura</a><a href="#metodo">Método</a><a href="#contacto">Contacto</a></nav>
  </div>

  <header class="hero">
    <span class="label">Arquitecto de soluciones de IA · Bogotá</span>
    <h1>El modelo <span class="ai">conversa</span>.<br />El código <span class="det">decide</span>.</h1>
    <p class="lede">Soy Mario Zarta. Diseño y construyo agentes de IA que llegan a producción: hablan con el cliente, usan herramientas y dejan el dinero, los datos y las acciones irreversibles en código verificable.</p>
    <div class="who">
      <span><b>10+ años</b> en software y producto</span>
      <span><b>Líder de IA</b> · Consultorsalud</span>
      <span><b>Claude · MCP · Agentes · RAG</b></span>
    </div>
    <Lanes />
    <a class="cta" href="/arquitectura">Cómo diseño agentes →</a>
  </header>

  <section class="section" id="agentes">
    <span class="label">Agentes construidos</span>
    <h2>{agentes.length} agentes, la misma regla</h2>
    {agentes.map((a) => <AgentCard a={a} />)}
  </section>

  <Method />
  <Contact />
</Base>
<style>
  .top{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;font-family:var(--mono);font-size:13px}
  .top .brand{color:var(--ink);text-decoration:none} .brand span{color:var(--gold)}
  nav{display:flex;gap:16px;flex-wrap:wrap}
  nav a{color:var(--muted);text-decoration:none} nav a:hover{color:var(--ink)}
  .hero{display:flex;flex-direction:column;gap:22px}
  .ai{color:var(--ai)} .det{color:var(--gold)}
  .lede{font-size:clamp(17px,2.2vw,20px);color:var(--muted);max-width:60ch}
  .who{display:flex;flex-wrap:wrap;gap:8px 18px;font-family:var(--mono);font-size:13px;color:var(--muted)}
  .who b{color:var(--ink);font-weight:500}
  .cta{align-self:flex-start;font-family:var(--display);font-size:22px;font-weight:700;color:var(--ink);text-decoration:none;
    border-bottom:2px solid var(--gold);padding-bottom:2px}
  .cta:hover{color:var(--gold)}
</style>
