---
interface Props { pasos: { texto: string; det?: boolean }[] }
const { pasos } = Astro.props;
---
<div class="flow">
  {pasos.map((p, i) => (
    <>
      {i > 0 && <span class="arr" aria-hidden="true">→</span>}
      <span class:list={['node', { det: p.det }]}>{p.texto}</span>
    </>
  ))}
</div>
<style>
  .flow{display:flex;flex-wrap:wrap;align-items:center;gap:6px;font-family:var(--mono);font-size:12px}
  .node{border:1px solid var(--ai);background:var(--ai-dim);padding:5px 9px;border-radius:4px}
  .node.det{border-color:var(--gold);background:var(--gold-dim)}
  .arr{color:var(--muted)}
</style>
